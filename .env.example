# Railway Postgres (or any Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway?sslmode=require"

# Admin dashboard password
ADMIN_PASSWORD="changeme"

# Public site URL (used in email links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Branding (Drukair template defaults)
NEXT_PUBLIC_BRAND_SHORT_NAME="Drukair"
BRAND_AIRLINE_NAME="Drukair – Royal Bhutan Airlines"
BRAND_SHORT_NAME="Drukair"
BRAND_BOOKING_PREFIX="DRK"
BRAND_RESERVATIONS_TEAM="Reservations Team"
BRAND_SUPPORT_EMAIL="reservations@drukair.com.bt"

# Square payments
SQUARE_ACCESS_TOKEN="sandbox-sq0idb-..."
NEXT_PUBLIC_SQUARE_APPLICATION_ID="sandbox-sq0idb-..."
NEXT_PUBLIC_SQUARE_LOCATION_ID="L..."
SQUARE_ENVIRONMENT="sandbox"

# Bank transfer invoice details
BANK_NAME="Commonwealth Bank"
BANK_ACCOUNT_NAME="Drukair Australia"
BANK_BSB="123-456"
BANK_ACCOUNT_NUMBER="12345678"

# Email — use Resend OR SMTP
EMAIL_FROM="Reservations Team <reservations@yourdomain.com>"
RESEND_API_KEY=""
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"

# Optional: protect /api/cron/expire-holds (Vercel Cron sends Authorization: Bearer …)
CRON_SECRET=""
